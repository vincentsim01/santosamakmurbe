// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role
  phone       String?
  createdAt   DateTime @default(now())

  // Relations
  vendor        Vendor?
  customer      Customer?
  logistic      LogisticPartner?

  orders        Order[]        @relation("CustomerOrders")
  transactions   Transaction[]
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
  LOGISTIC
}

//
// CUSTOMER PROFILE
//
model Customer {
  id        String   @id @default(uuid())

  address   String?
  city      String?
  country   String?
  phone     String?

  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])


}

//
// VENDOR PROFILE
//
model Vendor {
  id          String    @id @default(uuid())
  userId      String    @unique
  storeName   String
  description String?
  createdAt   DateTime  @default(now())
  address     String?
  phone       String?

  user        User      @relation(fields: [userId], references: [id])

  products    Product[]
  categories  Category[]
  orders      Order[]
}

//
// LOGISTIC PARTNER
//
model LogisticPartner {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  phone       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  deliveries  Order[]
}


//categories
model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  vendorId    String?
  createdAt   DateTime  @default(now())

  vendor      Vendor?   @relation(fields: [vendorId], references: [id])
  products    Product[]
}

//
// PRODUCTS
//
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  categoryId  String?
  vendorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category? @relation(fields: [categoryId], references: [id])
  vendor      Vendor    @relation(fields: [vendorId], references: [id])

  variants    ProductVariant[]

  // NEW: relation to warehouse stock
  warehouses  ProductWarehouse[]
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // existing relations (if any)
  products  ProductWarehouse[]

  // ADD THIS
  stockMovements StockMovement[]
}

model ProductWarehouse {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId]) // one record per product per warehouse
}

//
//product variants
//
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String
  price         Float

  product       Product   @relation(fields: [productId], references: [id])

  orderItems    OrderItem[]
  stockMovements StockMovement[]   // ← opposite relation
}

//
// ORDER
//
model Order {
  id               String   @id @default(uuid())
  customerId       String
  vendorId         String
  logisticPartnerId String?
  totalAmount      Float
  status           OrderStatus @default(PENDING)
  createdAt        DateTime @default(now())

  customer         User     @relation("CustomerOrders", fields: [customerId], references: [id])
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  logisticPartner  LogisticPartner? @relation(fields: [logisticPartnerId], references: [id])

  items            OrderItem[]
  transaction      Transaction?
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

//
// ORDER ITEMS
//
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float


  order     Order   @relation(fields: [orderId], references: [id])

    variant    ProductVariant @relation(fields: [variantId], references: [id])
}

//
// PAYMENT METHOD
//
model PaymentMethod {
  id          String   @id @default(uuid())
  name        String   // e.g. Credit Card, Bank Transfer, eWallet
  provider    String?  // e.g. Stripe, Xendit, Midtrans
  createdAt   DateTime @default(now())

  transactions Transaction[]
}

//
// TRANSACTION (Payment Record)
//
model Transaction {
  id               String   @id @default(uuid())
  orderId          String   @unique
  userId           String
  paymentMethodId  String
  amount           Float
  status           PaymentStatus @default(PENDING)
  externalRef      String?   // gateway transaction id
  createdAt        DateTime  @default(now())

  order            Order     @relation(fields: [orderId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  paymentMethod    PaymentMethod @relation(fields: [paymentMethodId], references: [id])
}

model StockMovement {
  id          String        @id @default(uuid())
  variantId   String
  warehouseId String
  quantity    Int
  type        MovementType
  createdAt   DateTime      @default(now())

  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}