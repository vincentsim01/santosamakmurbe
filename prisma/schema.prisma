// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"

}



model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role
  phone       String?
  createdAt   DateTime @default(now())

  // Relations
  vendor        Vendor?
  customer      Customer?
  logistic      LogisticPartner?

  orders        Order[]        @relation("CustomerOrders")
  transactions   Transaction[]
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
  LOGISTIC
}

//
// CUSTOMER PROFILE
//
model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String?
  city      String?
  country   String?

  user      User     @relation(fields: [userId], references: [id])
}

//
// VENDOR PROFILE
//
model Vendor {
  id          String    @id @default(uuid())
  userId      String    @unique
  storeName   String
  description String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  products    Product[]
  categories  Category[]
  orders      Order[]
}

//
// LOGISTIC PARTNER
//
model LogisticPartner {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  phone       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  deliveries  Order[]
}


//categories
model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  vendorId    String?
  createdAt   DateTime  @default(now())

  vendor      Vendor?   @relation(fields: [vendorId], references: [id])
  products    Product[]
}

//
// PRODUCTS
//
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  categoryId  String?
  vendorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category? @relation(fields: [categoryId], references: [id])
  vendor      Vendor    @relation(fields: [vendorId], references: [id])

  orderItems  OrderItem[]
}
//
// ORDER
//
model Order {
  id               String   @id @default(uuid())
  customerId       String
  vendorId         String
  logisticPartnerId String?
  totalAmount      Float
  status           OrderStatus @default(PENDING)
  createdAt        DateTime @default(now())

  customer         User     @relation("CustomerOrders", fields: [customerId], references: [id])
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  logisticPartner  LogisticPartner? @relation(fields: [logisticPartnerId], references: [id])

  items            OrderItem[]
  transaction      Transaction?
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

//
// ORDER ITEMS
//
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

//
// PAYMENT METHOD
//
model PaymentMethod {
  id          String   @id @default(uuid())
  name        String   // e.g. Credit Card, Bank Transfer, eWallet
  provider    String?  // e.g. Stripe, Xendit, Midtrans
  createdAt   DateTime @default(now())

  transactions Transaction[]
}

//
// TRANSACTION (Payment Record)
//
model Transaction {
  id               String   @id @default(uuid())
  orderId          String   @unique
  userId           String
  paymentMethodId  String
  amount           Float
  status           PaymentStatus @default(PENDING)
  externalRef      String?   // gateway transaction id
  createdAt        DateTime  @default(now())

  order            Order     @relation(fields: [orderId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  paymentMethod    PaymentMethod @relation(fields: [paymentMethodId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}